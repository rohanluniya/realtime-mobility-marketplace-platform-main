# Real-Time Mobility Marketplace & Dynamic Pricing Data Platform
# Copy to .env for local execution. Never commit real credentials.

MARKETPLACE_ENV=dev
MARKETPLACE_EXECUTION_PROFILE=local_native
MARKETPLACE_TRANSPORT_MODE=local_wal
MARKETPLACE_SERVING_STORE=local_kv
MARKETPLACE_LOCAL_DATA_DIR=.local_data

# Kafka 4.3.2 (KRaft) & Apicurio Registry 3.3.5 (Docker mode)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081/apis/ccompat/v7

# Valkey 9.2.0 Low-Latency Materialized State Store (Docker mode)
VALKEY_HOST=localhost
VALKEY_PORT=6379
VALKEY_PASSWORD=change_me_dev_valkey_password

# RustFS 1.0.6 S3 & Lakekeeper v0.15.1 Iceberg REST Catalog (Docker mode)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=change_me_dev_s3_key
S3_SECRET_ACCESS_KEY=change_me_dev_s3_secret
ICEBERG_REST_URI=http://localhost:8181/catalog
ICEBERG_WAREHOUSE=marketplace

# PostgreSQL 17 / PostGIS 3.6 Operational DB (Docker mode)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=marketplace_ops
POSTGRES_USER=marketplace_admin
POSTGRES_PASSWORD=change_me_dev_pg_password

# FastAPI Serving & RBAC (dev defaults; replace via secret manager in production)
MARKETPLACE_API_HOST=127.0.0.1
MARKETPLACE_API_PORT=8010
MARKETPLACE_API_ADMIN_TOKEN=dev-mkt-admin-token
MARKETPLACE_API_OPERATOR_TOKEN=dev-mkt-operator-token
MARKETPLACE_API_ANALYST_TOKEN=dev-mkt-analyst-token

# Observability & Lineage
OPENLINEAGE_URL=http://localhost:5000
OPENLINEAGE_NAMESPACE=realtime-mobility-marketplace
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
LOG_LEVEL=INFO
