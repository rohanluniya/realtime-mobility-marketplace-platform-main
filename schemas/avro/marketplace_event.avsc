{
  "type": "record",
  "name": "MarketplaceEvent",
  "namespace": "io.marketplace.events.v1",
  "doc": "Unified versioned Avro contract for rider, driver, trip, dispatch, and regional marketplace events.",
  "fields": [
    {"name": "event_id", "type": "string"},
    {"name": "event_type", "type": "string"},
    {"name": "event_time", "type": "string"},
    {"name": "producer_time", "type": "string"},
    {"name": "ingestion_time", "type": ["null", "string"], "default": null},
    {"name": "schema_version", "type": "string", "default": "1.0.0"},
    {"name": "rider_id", "type": ["null", "string"], "default": null},
    {"name": "driver_id", "type": ["null", "string"], "default": null},
    {"name": "request_id", "type": ["null", "string"], "default": null},
    {"name": "trip_id", "type": ["null", "string"], "default": null},
    {"name": "region_id", "type": "string"},
    {"name": "city_id", "type": "string"},
    {"name": "latitude", "type": "double"},
    {"name": "longitude", "type": "double"},
    {"name": "correlation_id", "type": "string"},
    {"name": "trace_id", "type": "string"},
    {"name": "sequence_number", "type": ["null", "long"], "default": null},
    {"name": "payload_json", "type": "string"},
    {"name": "metadata", "type": {"type": "map", "values": "string"}, "default": {}}
  ]
}
