{
  "type": "record",
  "name": "PricingDecisionEvent",
  "namespace": "io.marketplace.events.v1",
  "doc": "Explainable, versioned, replayable dynamic pricing recommendation per H3 cell.",
  "fields": [
    {"name": "decision_id", "type": "string"},
    {"name": "decision_version", "type": "long"},
    {"name": "region_id", "type": "string"},
    {"name": "city_id", "type": "string"},
    {"name": "h3_cell", "type": "string"},
    {"name": "h3_resolution", "type": "int"},
    {"name": "decision_time", "type": "string"},
    {"name": "effective_time", "type": "string"},
    {"name": "input_window", "type": "string"},
    {"name": "demand_count", "type": "int"},
    {"name": "supply_count", "type": "int"},
    {"name": "neighbor_supply_count", "type": "int"},
    {"name": "demand_growth_rate", "type": "double"},
    {"name": "recent_match_rate", "type": "double"},
    {"name": "estimated_wait_seconds", "type": "double"},
    {"name": "traffic_factor", "type": "double"},
    {"name": "regional_event_active", "type": "boolean"},
    {"name": "input_freshness_seconds", "type": "double"},
    {"name": "raw_multiplier", "type": "double"},
    {"name": "pricing_multiplier", "type": "double"},
    {"name": "policy_version", "type": "string"},
    {"name": "model_version", "type": "string"},
    {"name": "experiment_id", "type": ["null", "string"], "default": null},
    {"name": "experiment_variant", "type": ["null", "string"], "default": null},
    {"name": "reason_codes", "type": {"type": "array", "items": "string"}},
    {"name": "decision_status", "type": "string"},
    {"name": "correlation_id", "type": "string"},
    {"name": "trace_id", "type": "string"},
    {"name": "schema_version", "type": "string", "default": "1.0.0"}
  ]
}
