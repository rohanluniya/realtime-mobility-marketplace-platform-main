    {"name": "trip_id", "type": ["null", "string"], "default": null},
    {"name": "rider_id", "type": "string"},
    {"name": "driver_id", "type": ["null", "string"], "default": null},
    {"name": "city_id", "type": "string"},
    {"name": "region_id", "type": "string"},
    {"name": "h3_cell_res7", "type": "string"},
    {"name": "service_type", "type": "string"},
    {"name": "request_time", "type": "string"},
    {"name": "outcome_time", "type": "string"},
    {"name": "final_status", "type": "string"},
    {"name": "request_to_offer_ms", "type": ["null", "long"], "default": null},
    {"name": "offer_to_accept_ms", "type": ["null", "long"], "default": null},
    {"name": "request_to_match_ms", "type": ["null", "long"], "default": null},
